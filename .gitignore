# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Large media are hosted outside the Git repo / GitHub Pages build.
# Use lightweight GIFs/posters in the site instead.
assets/videos/
!assets/videos/
assets/videos/*
!assets/videos/demo.mp4
assets/videos_faststart/
assets/videos_1080p/
*.mp4
!assets/videos/demo.mp4
!assets/replay_videos_mp4/
!assets/replay_videos_mp4/*.mp4
*.mov
*.mkv
*.webm
*.zip

# Local backup of the previous oversized Git history.
.git_backup_with_videos_*/

# Local runtime logs.
data/system.log
